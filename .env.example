POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=test-user-123
POSTGRES_PASSWORD=test-postgres-password-123
POSTGRES_DB=test-db
POSTGRES_TIMEOUT=10s

LOGGER_LEVEL=debug
LOGGER_FOLDER=out/logs

HTTP_HOST=
HTTP_PORT=8080
HTTP_SHUTDOWN_TIMEOUT=10s

HTTP_CORS_ALLOWED_ORIGINS=http://localhost:8050
HTTP_CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
HTTP_CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Use REDIS_URL (for example, Render's internal connection string) or the
# individual REDIS_HOST/REDIS_PORT/REDIS_PASSWORD/REDIS_DB variables below.
# REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=test-redis-password-123
REDIS_DB=0
REDIS_TTL=5m

TIME_ZONE=UTC

# Optional Postgres sslmode (defaults to disable).
# POSTGRES_SSLMODE=disable
